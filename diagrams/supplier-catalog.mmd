%%{init: {
  "htmlLabels": false,
  "look": "neo",
  "theme": "base",
  "themeVariables": {
    "fontFamily": "IBM Plex Sans",
    "fontSize": "13px",
    "lineColor": "#7894ad",
    "primaryBorderColor": "#b8c2cc",
    "primaryColor": "#f8f7f3",
    "primaryTextColor": "#334155",
    "clusterBkg": "#fbfcfd",
    "clusterBorder": "#c5d3df",
    "titleColor": "#334155",
    "tertiaryColor": "#eef3f7",
    "tertiaryBorderColor": "#c5d3df"
  },
  "flowchart": {
    "curve": "linear",
    "nodeSpacing": 40,
    "rankSpacing": 60,
    "padding": 15,
    "subGraphTitleMargin": {
      "top": 10,
      "bottom": 4
    }
  }
}}%%
flowchart TD
  classDef process fill:#f8f7f3,stroke:#b8c2cc,stroke-width:2px
  classDef inputOutput fill:#dce8f2,stroke:#5f86a5,stroke-width:2px
  classDef storage fill:#eef3f7,stroke:#7894ad,stroke-width:2px
  classDef finish fill:#e8f0eb,stroke:#789487,stroke-width:2px
  classDef external fill:#eef3f7,stroke:#7894ad,stroke-width:2px,stroke-dasharray:4 3
  classDef error fill:#f3e9e7,stroke:#a47d77,stroke-width:2px,stroke-dasharray:4 3

  subgraph intake[" "]
    direction LR
    supplier[/Supplier files/]
    object[("Object storage")]

    supplier --> object
  end

  subgraph processing[" "]
    direction LR
    mapping["Mapping and Parsing"]
    workers["Background workers"]

    mapping --> workers
  end

  object --> mapping

  subgraph enrichment[" "]
    direction LR
    services[/External data services/]
    calculations["Process and Calculations"]

    services --> calculations
  end

  workers --> services

  subgraph output[" "]
    direction TB
    dataset[("Product dataset")]
    dashboard[/Operational dashboard/]

    calculations --> dataset
    dataset --> dashboard
  end

  subgraph recovery[" "]
    direction TB
    retry["Retry / backoff"]
    failed["Error state"]

    services -.-> retry
    retry -.-> calculations
    services -.-> failed
  end

  class mapping,workers,calculations,retry process
  class supplier inputOutput
  class object,dataset storage
  class services external
  class dashboard finish
  class failed error

  linkStyle 0,1,2,3,4,5,6 stroke:#7894ad,stroke-width:1.5px
  linkStyle 7,8,9 stroke:#a47d77,stroke-width:1px,stroke-dasharray:5 3
