%%{init: {
  "htmlLabels": false,
  "theme": "base",
  "themeVariables": {
    "fontFamily": "IBM Plex Sans",
    "fontSize": "13px",
    "lineColor": "#7894ad",
    "primaryBorderColor": "#b8c2cc",
    "primaryColor": "#f8f7f3",
    "primaryTextColor": "#334155",
    "clusterBkg": "#fbfcfd",
    "clusterBorder": "#eef2f5",
    "tertiaryColor": "#eef3f7",
    "tertiaryBorderColor": "#c5d3df"
  },
  "flowchart": {
    "curve": "linear",
    "nodeSpacing": 40,
    "rankSpacing": 60,
    "padding": 15
  }
}}%%
flowchart TD
  classDef worker fill:#dce8f2,stroke:#5f86a5,stroke-width:1.5px
  classDef storage fill:#f3f5f6
  classDef external stroke:#7894ad,stroke-dasharray:4 3
  classDef output fill:#e8f0f5,stroke:#7894ad
  classDef error fill:#fbf3f1,stroke:#c89b92,stroke-dasharray:4 3

  subgraph intake[" "]
    direction LR
    supplier["Supplier files"] --> object[("Object storage")]
  end

  subgraph processing[" "]
    direction RL
    mapping["Mapping and Parsing"] --> workers["Continuous workers"]
  end

  object --> mapping

  subgraph enrichment[" "]
    direction LR
    services["External data services"] --> calculations["Process and Calculations"]
  end

  workers --> services
  calculations --> dataset[("Product dataset")]
  dataset --> dashboard["Operational dashboard"]

  services -.-> retry["Retry / backoff"]
  retry -.-> calculations
  services -.-> failed["Error state"]

  class workers worker
  class object,dataset storage
  class services external
  class dashboard output
  class retry,failed error

  linkStyle 0,1,2,3,4,5,6 stroke:#7894ad,stroke-width:1.5px
  linkStyle 7,8 stroke:#7894ad,stroke-width:1px,stroke-dasharray:5 3
  linkStyle 9 stroke:#c89b92,stroke-width:1px,stroke-dasharray:5 3
